        <item>
            <title>2.10.0</title>
            <pubDate>Mon, 14 Sep 2026 10:39:14 -0400</pubDate>
            <link>https://github.com/hoomanaskari/mac-dictate-anywhere</link>
            <sparkle:version>40</sparkle:version>
